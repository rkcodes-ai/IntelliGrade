# ==================================================
# IntelliGrade — Root Environment Template (Docker Compose)
# Copy to `.env` and fill in real values. Never commit `.env`.
# Service-specific templates: backend/.env.example, frontend/.env.example
# ==================================================

# --- General ---
COMPOSE_PROJECT_NAME=intelligrade
ENVIRONMENT=development

# --- PostgreSQL ---
POSTGRES_USER=intelligrade
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=intelligrade
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379
REDIS_PASSWORD=

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=intelligrade
MINIO_ROOT_PASSWORD=change_me_dev_only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=intelligrade-uploads

# --- Backend ---
BACKEND_PORT=8000
SECRET_KEY=change_me_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
