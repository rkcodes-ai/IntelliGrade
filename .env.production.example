# ==================================================
# IntelliGrade — PRODUCTION environment template
# Copy to `.env.production` and fill in REAL values generated for this
# deployment. Never commit `.env.production`. See docs/environment-guide.md
# and docs/production-checklist.md before going live with these.
# ==================================================

# --- General ---
ENVIRONMENT=production
IMAGE_TAG=latest

# --- PostgreSQL ---
# Use a strong, unique, randomly generated password — never the dev default.
POSTGRES_USER=intelligrade
POSTGRES_PASSWORD=REPLACE_ME_STRONG_RANDOM_PASSWORD
POSTGRES_DB=intelligrade

# --- Redis ---
# `redis-server --requirepass` is enforced in docker-compose.prod.yml —
# this MUST be set (unlike the dev compose, where it's optional).
REDIS_PASSWORD=REPLACE_ME_STRONG_RANDOM_PASSWORD

# --- MinIO ---
MINIO_ROOT_USER=intelligrade
MINIO_ROOT_PASSWORD=REPLACE_ME_STRONG_RANDOM_PASSWORD
MINIO_BUCKET_NAME=intelligrade-uploads

# --- Nginx reverse proxy ---
HTTP_PORT=80
HTTPS_PORT=443

# --- Backend (consumed via env_file: .env.production, see docker-compose.prod.yml) ---
# Generate with: openssl rand -hex 32
SECRET_KEY=REPLACE_ME_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=https://your-domain.example.com
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=1800
SLOW_QUERY_THRESHOLD_MS=200
DATABASE_CONNECT_TIMEOUT_SECONDS=3
REDIS_CONNECT_TIMEOUT_SECONDS=3
RATE_LIMIT_DEFAULT=100/minute
LOG_LEVEL=INFO
LOG_JSON=true

# --- Frontend build arg (baked into the static bundle at build time — see
# frontend/Dockerfile; changing this after deploy requires a rebuild) ---
# `/api/v1` (a same-origin relative path) is the recommended default: the
# reverse proxy forwards it to the backend container, so the browser never
# makes a cross-origin request and CORS_ORIGINS above only needs to cover
# your real public domain, not the API host separately.
VITE_API_BASE_URL=/api/v1
