# Copy to `.env` for local (non-Docker) backend development. Never commit `.env`.

ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

SECRET_KEY=change_me_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:5173

POSTGRES_USER=intelligrade
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=intelligrade
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
# Module 08: recycle pooled connections before a managed DB/load balancer
# silently drops an idle one; bound how long a new connection attempt may
# take (avoids a slow /health/ready when the DB is unreachable).
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=3
# Module 08: log any query slower than this as `slow_query`; 0 disables.
SLOW_QUERY_THRESHOLD_MS=200

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CONNECT_TIMEOUT_SECONDS=3

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=intelligrade
MINIO_SECRET_KEY=change_me_dev_only
MINIO_BUCKET_NAME=intelligrade-uploads
MINIO_SECURE=false

# Answer Script upload / OCR pipeline (Module 05)
UPLOAD_MAX_FILE_SIZE_BYTES=52428800
UPLOAD_MAX_PAGE_COUNT=60
UPLOAD_CHUNK_SIZE_BYTES=5242880
UPLOAD_TEMP_DIR=/tmp/intelligrade-uploads
# Leave unset on Linux/Docker (tesseract-ocr apt package puts it on PATH).
# On Windows dev machines, set to the installed binary, e.g.:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
OCR_MAX_RETRY_ATTEMPTS=3
OCR_TASK_SOFT_TIME_LIMIT_SECONDS=300

# Multi-OCR & Cloud Providers (Optional)
# GOOGLE_VISION_CREDENTIALS_PATH=/path/to/google-vision-credentials.json
# GOOGLE_VISION_PROJECT_ID=REPLACE_ME_GCP_PROJECT_ID
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://REPLACE_ME.cognitiveservices.azure.com/
# AZURE_DOCUMENT_INTELLIGENCE_API_KEY=REPLACE_ME_AZURE_KEY
# AWS_TEXTRACT_REGION=us-east-1
# AWS_ACCESS_KEY_ID=REPLACE_ME_AWS_ACCESS_KEY
# AWS_SECRET_ACCESS_KEY=REPLACE_ME_AWS_SECRET_KEY

# Cloud AI Evaluation Providers (Optional)
# OPENAI_API_KEY=REPLACE_ME_OPENAI_KEY
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=REPLACE_ME_ANTHROPIC_KEY
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

RATE_LIMIT_DEFAULT=100/minute

LOG_LEVEL=INFO
LOG_JSON=false

